{
  "name": "oc-loop",
  "version": "0.1.0-beta.1",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Safe autonomous loop/workflow plugin for OpenCode 2: admission-gated dispatch, durable event-sourced state, command/approval/condition nodes, templates.",
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=22",
    "opencode": ">=0.0.0-beta-18155"
  },
  "exports": {
    ".": "./dist/src/server.js",
    "./server": "./dist/src/server.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run smoke && npm run build",
    "build": "tsc --outDir dist --declaration false --noEmit false"
  },
  "dependencies": {
    "@opencode-ai/plugin": "0.0.0-beta-18155",
    "@opencode-ai/client": "0.0.0-beta-18155",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opencode-ai/theme": "^0.0.0-beta-18155",
    "@opentui/core": "^0.5.8",
    "@opentui/solid": "^0.5.8",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "fast-check": "^4.2.0",
    "solid-js": "^1.9.12",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
